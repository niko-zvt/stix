{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stix",
  "version": "0.9.0",
  "identifier": "com.stix.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "postit",
        "title": "Stix",
        "width": 400,
        "height": 300,
        "minWidth": 320,
        "minHeight": 200,
        "maxWidth": 800,
        "maxHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; img-src 'self' data: http://asset.localhost https://asset.localhost https: http:; font-src 'self' data: https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Stix/**/.assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "externalBin": [
      "binaries/darwinkit"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyM0VGMjdCM0FCRjA5QzIKUldUQ0NiODZlL0krWXRQTGVwVlFYcnBsSWg3SkFKT2YySGNFdlhrbS9HNCtlaVNTUURaUUlrVXcK",
      "endpoints": [
        "https://github.com/niko-zvt/stix/releases/latest/download/latest.json"
      ]
    }
  }
}
